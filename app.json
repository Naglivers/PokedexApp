{
  "expo": {
    "name": "Pokédex Atlas",
    "slug": "pokedex-atlas",
    "version": "1.1.11",
    "icon": "./assets/brand/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/favicon.png"
    },
    "scheme": "pokedexatlas",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita escolher uma foto para seu perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "android": {
      "package": "com.pokedex.atlas",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#E95B54"
      }
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "57c73744-a385-47d8-aee6-6afc7474ae2a"
      }
    }
  }
}
