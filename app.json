{
  "expo": {
    "name": "Pokédex Atlas",
    "slug": "pokedex-atlas",
    "version": "1.1.6",
    "icon": "./assets/brand/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "web": { "bundler": "metro", "favicon": "./assets/brand/favicon.png" },
    "scheme": "pokedexatlas",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita escolher uma foto para seu perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "android": {
      "package": "com.pokedex.atlas",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#E95B54"
      }
    }
  }
}
